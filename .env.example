# Dhvaani Environment Configuration Template
# Copy this file to .env and provide your actual credentials.

# Google Gemini API Key (Optional if using OpenRouter for Gemini reasoning)
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# OpenRouter API Key (For Gemini reasoning / intent detection / context extraction via OpenRouter)
# Get your API key from OpenRouter: https://openrouter.ai/
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Sarvam AI API Key (For Indian language speech-to-text and text-to-speech)
# Get your API key from Sarvam AI Dashboard: https://dashboard.sarvam.ai/
SARVAM_API_KEY=your_sarvam_api_key_here

# SQLite Database Path (Optional, defaults to dhvaani.db in project root for local development)
DHVAANI_DB_PATH=dhvaani.db

# Production Database (PostgreSQL / Neon / Supabase / Vercel Postgres)
# When set, Dhvaani automatically connects to Postgres instead of SQLite
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Vercel Blob Storage Token (Optional for cloud evidence persistence on Vercel)
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Server Host & Port
HOST=0.0.0.0
PORT=8000
